# Kosongkan Supabase untuk mode demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kosong = basemap Esri World Topo bawaan. Isi URL style JSON MapLibre untuk mengganti.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_SNAPSHOT_FALLBACK_URL=
STATUS_CACHE_SECONDS=15

# Opsional: foto SPBU dari Google Places API (server saja, jangan pakai awalan NEXT_PUBLIC)
GOOGLE_PLACES_API_KEY=

# Opsional, gratis tanpa kartu: foto jalan dari Mapillary (daftar di mapillary.com/developer, ambil Client Token)
MAPILLARY_ACCESS_TOKEN=

# Opsional: kode verifikasi Google Search Console (metode tag HTML)
GOOGLE_SITE_VERIFICATION=
